# 산출물 (빌더가 런타임 생성하는 .pptx 저장 위치)
# `output/` 처럼 디렉터리 자체를 무시하면 git 은 그 안의 파일을 다시 포함시킬 수 없다(negation 불가).
# 그래서 내용물만 무시하는 `output/*` 형태로 쓰고 `.gitkeep` 만 되살린다. 의미는 기존과 동일하다.
output/*
!output/.gitkeep

# 임시 파일 (원자적 쓰기 .tmp-<uuid>.pptx)
.tmp-*

# PPTX 산출물 — 단 `template.pptx` 는 사용자 제공 자산이므로 커밋 대상으로 남긴다.
# (tests/test_cli.py·test_webapp.py 는 템플릿 부재를 스킵이 아니라 실패로 처리한다)
*.pptx
!template.pptx

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.eggs/
*.egg-info/
build/
dist/

# 도구 캐시 (린터/타입체커 미도입이지만 캐시 디렉터리가 생기면 추적하지 않는다)
.ruff_cache/
.pytest_cache/

# 에디터/OS
.idea/
.vscode/
Thumbs.db
desktop.ini
